# Demo works without external credentials. Set live only after setup.
NEXT_PUBLIC_APP_MODE=demo

# Server-only Supabase PostgreSQL connection string.
DATABASE_URL=

# Clerk application keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Browser-safe Supabase values. Enable Clerk third-party auth in Supabase.
# Never put a Supabase secret or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Test Mode only: RAZORPAY_KEY_ID must begin with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional during local development. The webhook returns 503 when empty.
RAZORPAY_WEBHOOK_SECRET=
